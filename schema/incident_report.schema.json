          }
        },
        "required": [
          "service",
          "signal",
          "observed",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "investigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "tool": {
            "type": "string",
            "enum": [
              "get_metrics",
              "get_traces",
              "get_logs",
              "get_container_health",
              "get_deploy_history",
              "health_table"
