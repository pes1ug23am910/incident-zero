            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "component",
        "cause",
        "category",
        "confidence"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(trace:[^\\s/:]+|span:[^\\s/:]+/[^\\s/:]+|log:[^\\s/]+/[^\\s/]+|metric:.+\\{.*\\}@[^=]+=[^=]+|container:[^\\s:]+:[^=]+=.+|action_log:[1-9][0-9]*|dlog:[^\\s/:]+:[a-f0-9]{64})$"
          },
          "source": {
            "type": "string",
            "enum": [
              "jaeger",
              "prometheus",
              "opensearch",
              "docker",
              "action_log"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "raw_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source",
          "summary",
          "raw_ref"
        ],
        "additionalProperties": false
      }
    },
    "proposed_action": {
      "oneOf": [
        {
          "type": "null"
