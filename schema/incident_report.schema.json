      "type": "object",
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "error_rate",
            "latency_p95",
            "container_health",
            "restart_count",
            "oom",
            "traffic",
            "no_alert",
            "resource_limits"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "window_s": {
          "type": "integer",
          "minimum": 1
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "signal",
        "service",
        "observed",
        "threshold",
        "window_s"
      ],
      "additionalProperties": false
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
