          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "application_flag",
            "container_down",
            "restart_loop",
            "dependency_unavailable",
            "network",
            "resource_starvation",
            "load",
            "unknown"
